# =========================================================================
# CrowdSense Audio - .gitignore (Production & GitHub Deployment Standard)
# =========================================================================

# 1. Python Environment & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 2. Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 3. Jupyter Notebook Checkpoints & Cache
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*-checkpoint.ipynb

# 4. IDEs, Editors & OS Files
.vscode/
.idea/
.claude/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# 5. Local Temp Audio & Caches
temp_uploaded_audio.wav
*.tmp
*.log

# 6. Raw Audio Backup Archive (168 MB Backup - kept locally)
AUDIO/
AUDIO/**

# 7. Data Folder Handling
# Keep structure, mapping file, and processed 32-feature dataset in Git:
data/01_raw/ramai/*
data/01_raw/tidak_ramai/*
data/02_chunks/ramai/*
data/02_chunks/tidak_ramai/*
*.wav
*.mp3
*.mpeg
*.m4a
*.ogg

# Wajib Lacak File Data Kunci:
!data/01_raw/file_mapping.csv
!data/03_processed/audio_features_32.csv
